{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@arethetypeswrong/cli", "publint", "madge", "tsx", "jscpd"],
  "tags": ["-knipignore"],
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.e2e.test.ts", "tools/*.mjs"],
      "project": ["e2e/**/*.ts", "tools/**/*.mjs"]
    },
    "packages/sdk": {
      "entry": ["src/agent.ts", "tests/**/*.test.ts", "tests/helpers/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        "jsonrepair",
        "@opentelemetry/exporter-metrics-otlp-http",
        "@opentelemetry/exporter-prometheus",
        "@opentelemetry/exporter-trace-otlp-http",
        "@opentelemetry/resources"
      ]
    },
    "packages/acp": {
      "entry": ["tests/fixtures/*.mjs"]
    },
    "packages/cli": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
