{
  "name": "@theokit/skills-registry",
  "version": "0.1.0",
  "description": "Skill package format, version resolution and verified, atomic install of SKILL.md folders from a skills registry.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheokit/theokit-sdk#readme",
  "bugs": "https://github.com/usetheokit/theokit-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-sdk.git",
    "directory": "packages/skills-registry"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ../../tools/repair-dts-imports.mjs .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../tools/check-publish-no-workspace.mjs ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
