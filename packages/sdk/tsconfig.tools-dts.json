{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "skipLibCheck": true
  },
  "include": [
    "src/messages.ts",
    "src/path-safety.ts",
    "src/compaction.ts",
    "src/models.ts",
    "src/providers.ts",
    "src/internal/llm/model-capabilities.ts",
    "src/skills.ts",
    "src/internal/runtime/skills/**/*",
    "src/project.ts",
    "src/internal/runtime/context/**/*",
    "src/context/**/*",
    "src/subagents.ts",
    "src/internal/runtime/compression/**/*",
    "src/concurrency.ts",
    "src/internal/runtime/concurrency/**/*",
    "src/retry.ts",
    "src/internal/runtime/retry/**/*",
    "src/task-store.ts",
    "src/internal/task/store.ts",
    "src/internal/persistence/**/*",
    "src/internal/plugins/**/*",
    "src/internal/observability/**/*",
    "src/internal/security/**/*",
    "src/internal/memory/**/*",
    "src/errors.ts",
    "src/agent.ts",
    "src/agent-factory.ts",
