    "src/internal/eval/**/*",
    "src/internal/workflow/**/*",
    "src/subscription/**/*",
    "src/sanitize/**/*",
    "src/auth/**/*",
    "src/internal/auth/**/*",
    "src/a2a/**/*",
    "src/client/**/*",
    "src/sandbox/**/*",
    "src/filesystem/**/*",
    "src/interactive/**/*",
    "src/server/**/*",
    "src/event-bus.ts",
    "src/job-queue.ts",
    "src/permission-engine.ts",
    "src/mcp-auth.ts",
    "src/internal/mcp/**/*"
  ]
}
