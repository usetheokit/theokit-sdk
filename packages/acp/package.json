{
  "name": "@theokit/acp",
  "version": "4.0.1",
  "description": "Agent Client Protocol (ACP) server adapter for @theokit/sdk. Exposes an SDKAgent over stdio JSON-RPC so any ACP-compatible host can drive it. ADRs D349-D360.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheokit/theokit-sdk#readme",
  "bugs": "https://github.com/usetheokit/theokit-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-sdk.git",
    "directory": "packages/acp"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "registry",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node ../../tools/repair-dts-imports.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../tools/check-publish-no-workspace.mjs ."
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@theokit/sdk": "workspace:^"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "~1.4.0",
    "@theokit/sdk": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "bin": {
    "theokit-acp": "./bin/theokit-acp.mjs"
  }
}
