{
  "name": "@theokit/sdk-tools",
  "version": "0.27.6",
  "description": "Built-in tools for @theokit/sdk agents — file system, git, subprocess, search-text, vitest runner.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheokit/theokit-sdk#readme",
  "bugs": "https://github.com/usetheokit/theokit-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-sdk.git",
    "directory": "packages/sdk-tools"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./extract-document": {
      "import": {
        "types": "./dist/extract-document.d.ts",
        "default": "./dist/extract-document.js"
      },
      "require": {
        "types": "./dist/extract-document.d.cts",
        "default": "./dist/extract-document.cjs"
      }
    },
    "./read-pdf": {
      "import": {
        "types": "./dist/read-pdf.d.ts",
        "default": "./dist/read-pdf.js"
      },
      "require": {
        "types": "./dist/read-pdf.d.cts",
        "default": "./dist/read-pdf.cjs"
      }
    },
    "./github-link-preview": {
      "import": {
        "types": "./dist/github-link-preview.d.ts",
        "default": "./dist/github-link-preview.js"
      },
      "require": {
        "types": "./dist/github-link-preview.d.cts",
        "default": "./dist/github-link-preview.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ../../tools/repair-dts-imports.mjs .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../tools/check-publish-no-workspace.mjs ."
  },
  "peerDependencies": {
    "@theokit/sdk": ">=5.0.0-next.1",
    "mammoth": "^1.13.0",
    "simple-git": "^4.0.1",
    "unpdf": "^2.1.0",
    "vitest": ">=2.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "mammoth": {
      "optional": true
    },
    "simple-git": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8",
    "@theokit/sdk": "workspace:*",
    "@theokit/sdk-cache": "workspace:*",
    "@theokit/sdk-handoff": "workspace:*",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
